{
  "expo": {
    "name": "Rhythm",
    "slug": "rhythm",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "rhythm",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rhythm.daily",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "カレンダーの予定をRhythmの出発プランへ変換するために使用します。",
        "NSRemindersUsageDescription": "リマインダーの情報をRhythmで利用するために使用します。",
        "NSMicrophoneUsageDescription": "音声入力で話した内容を文字に変換するためにマイクを使用します。",
        "NSSpeechRecognitionUsageDescription": "音声入力で話した内容を文字に変換するために音声認識を使用します。"
      },
      "buildNumber": "3",
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.security.application-groups": [
          "group.app.rhythm.daily"
        ]
      }
    },
    "android": {
      "package": "app.rhythm.daily",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_CALENDAR"
      ]
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "カレンダーの予定をRhythmの出発プランへ変換するために使用します。",
          "remindersPermission": "リマインダーの情報をRhythmで利用するために使用します。"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7559E8",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "好きな写真をRhythmの背景やトップ画像に設定するために使用します。",
          "cameraPermission": false
        }
      ],
      "expo-av",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Rhythmが音声入力に使うマイクへのアクセスを許可します。",
          "speechRecognitionPermission": "Rhythmが音声を文字に変換するための許可を使用します。"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ],
      "./plugins/with-rhythm-widget"
    ],
    "extra": {
      "eas": {
        "projectId": "9f27c177-8ebe-4ef2-a6f2-89b48f60a821"
      }
    },
    "owner": "rhythm-nn"
  }
}
