{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RHYTHM_ENABLE_WIDGET": "false",
        "EXPO_PUBLIC_RHYTHM_ADS_ENV": "development"
      }
    },
    "development-widget": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RHYTHM_ENABLE_WIDGET": "true",
        "EXPO_PUBLIC_RHYTHM_ADS_ENV": "development",
        "EXPO_PUBLIC_RHYTHM_PREMIUM_MONTHLY_PRODUCT_ID": "app.rhythm.daily.premium.monthly",
        "EXPO_PUBLIC_RHYTHM_PREMIUM_ANNUAL_PRODUCT_ID": "app.rhythm.daily.premium.yearly",
        "EXPO_PUBLIC_RHYTHM_DESIGN_CUSTOMIZE_PRODUCT_ID": "app.rhythm.daily.design.customize"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_RHYTHM_ADS_ENV": "development"
      }
    },
    "production": {
      "env": {
        "RHYTHM_ADS_ENV": "production",
        "EXPO_PUBLIC_RHYTHM_ADS_ENV": "production",
        "EXPO_PUBLIC_RHYTHM_BANNER_AD_UNIT_ID": "ca-app-pub-3848456861839903/5329259314",
        "EXPO_PUBLIC_RHYTHM_REWARDED_AD_UNIT_ID": "ca-app-pub-3848456861839903/8039183132"
      }
    }
  }
}
