{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RHYTHM_ENABLE_WIDGET": "false"
      }
    },
    "development-widget": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "RHYTHM_ENABLE_WIDGET": "true"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {}
  }
}
